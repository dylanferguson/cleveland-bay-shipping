{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cleveland-bay-shipping",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "AIS_HUB", "class_name": "AisHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AisHub"] }],
  "observability": { "enabled": true }
}
